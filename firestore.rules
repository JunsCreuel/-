rules_version = '2';

// Firebase 콘솔 > Firestore Database > Rules 탭에 이 내용을 붙여넣고 게시하세요.
// (이 저장소에는 참고용으로만 보관 — 이 파일 자체가 자동으로 배포되지는 않습니다.)
service cloud.firestore {
  match /databases/{database}/documents {

    // 닉네임 프로필. 본인 문서만 만들고 수정할 수 있고, 누구나 읽을 수 있다
    // (사연 작성자 닉네임 표시, 신규 컬렉션에서 참조하기 위해).
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // 3단계(방 목록/방 상세) 이후 rooms/stories 등 컬렉션 규칙을 여기에 추가합니다.
  }
}
